{
  "batch_game_daily": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        }
      ],
      "properties": {
        "appid": {
          "type": "integer"
        },
        "name": {
          "type": "keyword"
        },
        "genres": {
          "type": "keyword"
        },
        "developer": {
          "type": "keyword"
        },
        "price": {
          "type": "float"
        },
        "price_bucket": {
          "type": "keyword"
        },
        "dt": {
          "type": "date",
          "format": "strict_date_optional_time||yyyy-MM-dd||yyyy-MM||epoch_second"
        },
        "total_reviews": {
          "type": "long"
        },
        "positive_reviews": {
          "type": "long"
        },
        "negative_reviews": {
          "type": "long"
        },
        "positive_ratio_percent": {
          "type": "float"
        },
        "avg_votes_up": {
          "type": "float"
        },
        "median_playtime_hours": {
          "type": "float"
        },
        "avg_sentiment": {
          "type": "float"
        },
        "suspicious_reviews": {
          "type": "long"
        },
        "avg_ccu": {
          "type": "float"
        },
        "peak_ccu": {
          "type": "long"
        }
      }
    }
  },
