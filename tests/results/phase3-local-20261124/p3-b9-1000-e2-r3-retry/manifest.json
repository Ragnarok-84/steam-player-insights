{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "p3-b9-1000-e2-r3-retry",
    "namespace": "steam-ft"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 900,
    "template": {
      "metadata": {
        "labels": {
          "spark-role": "driver",
          "steam-benchmark": "p3-b9-1000-e2-r3-retry"
        },
        "annotations": {
          "kubectl.kubernetes.io/default-container": "driver"
        }
      },
      "spec": {
        "serviceAccountName": "spark-driver",
        "restartPolicy": "Never",
        "nodeSelector": {
          "kubernetes.io/hostname": "steam-worker-3"
        },
        "containers": [
          {
            "name": "driver",
            "image": "localhost/steam-spark:k3s-20261124-1d45953",
            "imagePullPolicy": "Never",
            "workingDir": "/opt/spark/work-dir",
            "command": [
              "python3",
              "-c",
              "\nimport sys\nimport time\n\nfrom processing.batch.b9_sentiment_classifier import train_sentiment_classifier\nfrom processing.common.spark_utils import get_spark_session\nfrom tests.results_log import record\nfrom tests.scalability.sc1_sc2_batch_benchmark import _wait_executors\n\nclean, curated, repeat = sys.argv[1:]\nspark = get_spark_session('Steam Phase 3 B9 recovery')\ntry:\n    _wait_executors(spark, 2, 180)\n    start = time.perf_counter()\n    models = train_sentiment_classifier(spark, clean, curated)\n    if {model['model'] for model in models} != {'logreg', 'vader'}:\n        raise RuntimeError('B9 did not produce both model evaluations')\n    notes = 'B9-only retry; original B2-B8 input; overhead=768Mi (original 512Mi); one core/executor'\n    args = dict(member='B', scale=1000, env='k3s', repeat=int(repeat), executors=2,\n                dataset='steam_1000g_20261118', notes=notes)\n    record(experiment='batch', job='b9', metrics={'duration_s': time.perf_counter() - start}, **args)\n    for model in models:\n        metrics = ['accuracy', 'f1', 'auc']\n        if model['model'] == 'logreg':\n            metrics += ['train_s', 'predict_s']\n        record(experiment='ml', job='b9' if model['model'] == 'logreg' else 'vader',\n               metrics={metric: model[metric] for metric in metrics}, **args)\nfinally:\n    spark.stop()\n",
              "hdfs://namenode:8020/steam/bench/runs/p3-batch-1000-e2/r3/clean",
              "hdfs://namenode:8020/steam/bench/runs/p3-b9-1000-e2-r3-retry/curated",
              "3"
            ],
            "volumeMounts": [
              {
                "name": "results",
                "mountPath": "/opt/spark/work-dir/tests/results"
              }
            ],
            "env": [
              {
                "name": "POD_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.name"
                  }
                }
              },
              {
                "name": "SPARK_DRIVER_HOST",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "status.podIP"
                  }
                }
              },
              {
                "name": "SPARK_MASTER",
                "value": "k8s://https://kubernetes.default.svc:443"
              },
              {
                "name": "SPARK_EXTRA_CONF",
                "value": "spark.kubernetes.namespace=steam-ft;spark.kubernetes.authenticate.oauthTokenFile=/var/run/secrets/kubernetes.io/serviceaccount/token;spark.kubernetes.authenticate.caCertFile=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt;spark.kubernetes.container.image=localhost/steam-spark:k3s-20261124-1d45953;spark.kubernetes.container.image.pullPolicy=Never;spark.kubernetes.driver.pod.name=$(POD_NAME);spark.driver.bindAddress=0.0.0.0;spark.driver.port=7078;spark.blockManager.port=7079;spark.kubernetes.executor.node.selector.steam.insights/compute=true;spark.kubernetes.executor.podTemplateFile=/opt/spark/work-dir/infra/k3s/executor-template.yaml;spark.kubernetes.executor.podNamePrefix=$(POD_NAME);spark.kubernetes.executor.label.steam-benchmark=p3-b9-1000-e2-r3-retry;spark.kubernetes.executor.request.cores=750m;spark.kubernetes.executor.limit.cores=1;spark.executor.instances=2;spark.executor.cores=1;spark.executor.memory=1g;spark.executor.memoryOverhead=768m;spark.dynamicAllocation.enabled=false;spark.hadoop.dfs.client.use.datanode.hostname=true;spark.hadoop.dfs.replication=2;spark.executorEnv.ELASTICSEARCH_HOSTS=http://elasticsearch:9200;spark.executorEnv.HADOOP_USER_NAME=hdfs"
              },
              {
                "name": "SPARK_DRIVER_MEMORY",
                "value": "1536m"
              },
              {
                "name": "SPARK_SHUFFLE_PARTITIONS",
                "value": "16"
              },
              {
                "name": "PYTHONUNBUFFERED",
                "value": "1"
              },
              {
                "name": "ELASTICSEARCH_HOSTS",
                "value": "http://elasticsearch:9200"
              },
              {
                "name": "KAFKA_BOOTSTRAP_SERVERS",
                "value": "kafka:9092"
              },
              {
                "name": "HDFS_NAMENODE_URL",
                "value": "hdfs://namenode:8020"
              },
              {
                "name": "HADOOP_USER_NAME",
                "value": "hdfs"
              },
              {
                "name": "HDFS_RAW_PATH",
                "value": "hdfs://namenode:8020/steam/bench/raw_1000"
              },
              {
                "name": "HDFS_CLEAN_PATH",
                "value": "hdfs://namenode:8020/steam/bench/runs/p3-b9-1000-e2-r3-retry/clean"
              },
              {
                "name": "HDFS_CURATED_PATH",
                "value": "hdfs://namenode:8020/steam/bench/runs/p3-b9-1000-e2-r3-retry/curated"
              },
              {
                "name": "HDFS_CHECKPOINT_PATH",
                "value": "hdfs://namenode:8020/steam/bench/runs/p3-b9-1000-e2-r3-retry/checkpoints"
              },
              {
                "name": "GIT_COMMIT",
                "value": "1d459539f58f058a2698f02a6d8bcee5e1565c31"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "1",
                "memory": "2Gi"
              },
              "limits": {
                "cpu": "2",
                "memory": "2432Mi"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "results",
            "hostPath": {
              "path": "/var/lib/steam-phase3/runs/p3-b9-1000-e2-r3-retry",
              "type": "Directory"
            }
          }
        ]
      }
    }
  }
}