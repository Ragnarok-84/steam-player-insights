# Sao chép thành .env rồi sửa. Không commit .env (đã gitignore).
# pipeline.py --profile local tự ghi đè đường dẫn HDFS/Hive bằng data/raw + data/lake,
# nên các biến HDFS_* / HIVE_* bên dưới chỉ dùng cho --profile cluster.

# Steam Web API (IStoreService/GetAppList cần key; CCU dùng key nếu có)
STEAM_API_KEY=your_steam_api_key_here
# Ghi đè khi test lỗi 429 bằng mock (tests/fault_tolerance/mock_steam_api.py)
# STEAM_WEB_API_BASE=http://localhost:8099

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REVIEWS=steam.reviews.raw
KAFKA_TOPIC_CCU=steam.players.ccu
KAFKA_TOPIC_META=steam.games.meta
KAFKA_TOPIC_ALERTS=steam.alerts

# HDFS (profile cluster)
HDFS_NAMENODE_URL=hdfs://namenode:8020
HDFS_RAW_PATH=/steam/raw
HDFS_CLEAN_PATH=/steam/clean
HDFS_CURATED_PATH=/steam/curated
HDFS_CHECKPOINT_PATH=/steam/checkpoints

# Elasticsearch & Kibana. Batch/streaming chỉ ghi ES khi chạy với --es (hoặc WRITE_ES=1)
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
KIBANA_HOST=http://localhost:5601

# Hive Metastore (profile cluster; local dùng HIVE_METASTORE_URI_LOCAL nếu muốn đăng ký bảng)
HIVE_METASTORE_URI=thrift://localhost:9083
# HIVE_METASTORE_URI_LOCAL=thrift://localhost:9083

# Spark
# SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=64
# Cấu hình thêm dạng k=v;k=v
# SPARK_EXTRA_CONF=spark.executor.memory=4g

# Ngưỡng cảnh báo speed layer
S2_SIGMA=3
S2_POSITIVE_DROP_POINTS=20
S2_MIN_NEGATIVE=10
S3_CHANGE_THRESHOLD=0.5
S3_MIN_BASELINE_CCU=100

# Crawler
CRAWLER_WORKER_ID=0
CRAWLER_TOTAL_WORKERS=1
CRAWLER_RATE_LIMIT_DELAY=1.5
CRAWLER_RATE_LIMIT_COOLDOWN=30
TARGET_APP_LIST_PATH=data/target_apps.json
CURSOR_STATE_DIR=data/crawler_state

# Standalone crawler mains; collect_local always writes local JSONL.
CRAWLER_OUTPUT=kafka
CRAWLER_OUTPUT_DIR=data/raw
CRAWLER_TARGET_LIMIT=1000
CRAWLER_REVIEW_BATCHES=1
