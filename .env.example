# Steam Web API
STEAM_API_KEY=your_steam_api_key_here

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REVIEWS=steam.reviews.raw
KAFKA_TOPIC_CCU=steam.players.ccu
KAFKA_TOPIC_META=steam.games.meta
KAFKA_TOPIC_ALERTS=steam.alerts

# HDFS Configuration
HDFS_NAMENODE_URL=hdfs://namenode:8020
HDFS_RAW_PATH=/steam/raw
HDFS_CLEAN_PATH=/steam/clean
HDFS_CURATED_PATH=/steam/curated
HDFS_CHECKPOINT_PATH=/steam/checkpoints

# Elasticsearch & Kibana Configuration
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
KIBANA_HOST=http://localhost:5601

# Hive Metastore
HIVE_METASTORE_URI=thrift://localhost:9083

# Crawler Settings
CRAWLER_WORKER_ID=0
CRAWLER_TOTAL_WORKERS=4
CRAWLER_RATE_LIMIT_DELAY=1.5
TARGET_APP_LIST_PATH=data/target_apps.json
CURSOR_STATE_DIR=/tmp/steam_crawler_state
