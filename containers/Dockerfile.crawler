FROM python:3.11-slim

WORKDIR /app
COPY requirements-crawler.txt .
RUN pip install --no-cache-dir -r requirements-crawler.txt

COPY crawlers/ crawlers/
# Chỉ danh sách game mục tiêu; không đưa dữ liệu raw (data/raw có thể nặng hàng GB) vào image
COPY data/target_apps.json data/target_apps.json

ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "crawlers.steam_reviews_crawler"]
